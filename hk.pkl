amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local checks = new Mapping<String, Step> {
    ["go-fmt"] = (Builtins.go_fmt) {
        glob = "**/*.go"
    }
    ["go-vet"] = (Builtins.go_vet) {
        glob = "**/*.go"
    }
    ["go-lint"] = (Builtins.golangci_lint) {
        glob = "**/*.go"
    }
    ["go-test-and-coverage"] {
        glob = "**/*.go"
        check = "go test -race -covermode=atomic -coverprofile=coverage.out ./... && covgate -threshold=80 coverage.out"
    }
    ["go-mod-tidy"] = (Builtins.gomod_tidy) {
        glob = List("**/*.go", "**/go.mod", "**/go.sum")
    }
    ["go-arch-lint"] {
        glob = List("**/*.go", ".go-arch-lint.yml", "mise.toml", "hk.pkl")
        check = "go-arch-lint check"
    }
    ["actionlint"] = (Builtins.actionlint) {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    }
}

steps = checks

hooks {
    ["pre-push"] {
        steps = checks
    }
    ["commit-msg"] {
        steps {
            ["conventional-commit"] = Builtins.check_conventional_commit
        }
    }
}
